{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clicky",
  "account_id": "6031f1f85e189c44fb3bcd150ca65920",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./build/website"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
